# Environment variables for ShopSense
# Adjust as needed for production
PORT=4000
NODE_ENV=production
JWT_SECRET=your_production_secret_here
CLIENT_ORIGIN=http://localhost:5173
# Optional AI answer generation (Gemini takes precedence over OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# SQLite DB path (relative to server directory)
DB_PATH=./server/db/database.sqlite
